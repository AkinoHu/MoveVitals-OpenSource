# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL. OAuth redirect URIs are derived from it:
#   ${APP_URL}/api/connections/<provider>/callback
APP_URL=http://localhost:3000

# Postgres connection string. Leave empty in local dev to use embedded PGlite (./.data/pglite).
DATABASE_URL=

# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts OAuth tokens and AI keys.
# Never change it after launch, or stored tokens become unreadable.
ENCRYPTION_KEY=

# Set to "false" to disable public sign-up.
ALLOW_SIGNUP=true
# Days of history pulled on first connect; worker sync interval.
BACKFILL_DAYS=180
SYNC_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# Providers (leave empty to hide the "connect" button)
# ---------------------------------------------------------------------------
# WHOOP — https://developer-dashboard.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Strava — https://www.strava.com/settings/api (Authorization Callback Domain: your domain)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Polar AccessLink — https://admin.polaraccesslink.com
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# Returned by `pnpm webhooks:setup polar`
POLAR_WEBHOOK_SECRET=

# Oura — https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_WEBHOOK_VERIFY_TOKEN=

# Withings — https://developer.withings.com/dashboard
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=


# Concept2 Logbook — https://log.concept2.com/developers/keys
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=

# Dexcom — https://developer.dexcom.com (DEXCOM_ENV=sandbox for sandbox data)
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
DEXCOM_ENV=

# ---------------------------------------------------------------------------
# Accounts, email and abuse protection
# ---------------------------------------------------------------------------
# Comma-separated emails that may open /admin. The address must also be VERIFIED
# (email link, or Google/Apple sign-in) - an unverified match grants nothing.
ADMIN_EMAILS=
# Transactional email (verification links) via Resend. Without it, accounts
# created with email + password cannot verify their address.
RESEND_API_KEY=
MAIL_FROM="MoveVitals <noreply@example.com>"
# Sign in with Google / Apple (leave empty to hide the buttons).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Apple bundle/Services IDs accepted as the token audience (default com.movevitals.app).
APPLE_AUDIENCES=
# Optional Cloudflare Turnstile CAPTCHA on sign-up/login (active only if BOTH are set).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Where the real client IP comes from, for rate limits. Choose ONE:
#   TRUSTED_PROXY_HOPS=1       number of proxies in front of the app that append to
#                              X-Forwarded-For (default 1 = Railway's edge); the entry is
#                              counted from the right, so a forged leftmost value is ignored
#   CLIENT_IP_HEADER=cf-connecting-ip   a header your edge sets and clients cannot forge
TRUSTED_PROXY_HOPS=
CLIENT_IP_HEADER=

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
# Strava/Oura/Withings/Concept2 do not sign their pushes, so each
# provider's webhook URL carries a secret key (?k=…) derived from ENCRYPTION_KEY.
# Print the URLs with `pnpm webhooks:setup <provider>`. Temporary bridge while you
# re-register old subscriptions: set to 1 to accept un-keyed requests (then remove).
WEBHOOK_ALLOW_UNKEYED=

# ---------------------------------------------------------------------------
# Bring-your-own AI
# ---------------------------------------------------------------------------
# Model base URLs must be https and public. Set to 1 ONLY on a self-hosted
# install that talks to a model on the same machine/LAN (e.g. Ollama on
# http://localhost:11434); it also shows the Ollama preset.
AI_ALLOW_PRIVATE_URLS=

# ---------------------------------------------------------------------------
# Backups (the worker writes an encrypted backup daily when a destination is set)
# ---------------------------------------------------------------------------
# 32 random bytes, base64 (`openssl rand -base64 32`). Use a DIFFERENT value from
# ENCRYPTION_KEY and store a copy outside Railway - without it backups cannot be read.
BACKUP_ENCRYPTION_KEY=
# Destination: S3-compatible (Cloudflare R2, S3…) or a local directory (volume).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETAIN=30

# Your own privacy policy and terms, linked from sign-up (both or neither).
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
