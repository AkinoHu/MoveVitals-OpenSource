    },
    "Average heart rate": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平均心率"
          }
        }
      }
    },
    "Best done in the morning, sitting or lying still. The reading is saved as HRV (RMSSD) from your strap.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议早晨坐着或躺着保持静止时测量。结果会以心率带的 HRV（RMSSD）保存。"
          }
        }
      }
    },
