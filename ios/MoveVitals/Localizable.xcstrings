  "strings": {
    "Active energy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动消耗"
          }
        }
      }
    },
    "Activities": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动"
          }
        }
      }
    },
    "Allow Bluetooth access for MoveVitals in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 MoveVitals 使用蓝牙。"
          }
        }
      }
    },
    "Apple Health": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 健康"
          }
        }
      }
    },
    "Apple Health and Bluetooth data stay on this iPhone. Turn sync on in Settings to see everything from all your devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 健康和蓝牙数据只保存在这台 iPhone 上。在“设置”中开启同步，即可看到所有设备的数据。"
          }
        }
      }
    },
    "Apple Health data is uploaded to your MoveVitals account so you can see it on the web and other devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 健康数据会上传到你的 MoveVitals 账户，方便在网页和其他设备上查看。"
          }
        }
      }
    },
    "Apple Health isn't available on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持 Apple 健康。"
          }
        }
      }
    },
    "Apple Health · on this iPhone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 健康 · 仅在本机"
